# ==============================================
# StarterKit Production Environment Variables
# ==============================================
# Copy this file to .env.prod in DEPLOY_DIR (default /opt/starterkit) on your server
# Edit all values marked with <CHANGE_ME>
#
# SECURITY: Never commit actual production secrets to Git!
# ==============================================

# ==============================================
# PROJECT CONFIGURATION
# ==============================================
COMPOSE_PROJECT_NAME=starterkit
ASPNETCORE_ENVIRONMENT=Production
TZ=UTC
# Public API domain (Nginx server_name / TLS certificate)
DOMAIN=api.example.com

# ==============================================
# DOCKER REGISTRY (Optional - for private registry)
# ==============================================
DOCKER_REGISTRY=ghcr.io
# ghcr.io/<owner>/<repo>-api (lowercase) - produced by .github/workflows/hybrid-ci-cd.yml
DOCKER_IMAGE=ghcr.io/your-org/starterkit-api
DOCKER_IMAGE_TAG=latest

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
POSTGRES_DB=starterkit
POSTGRES_USER=starterkit_user
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_PORT=5432

# PostgreSQL Performance (t3.medium optimized)
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=800m
POSTGRES_MEMORY_RESERVATION=400m

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_PASSWORD=<CHANGE_ME_STRONG_REDIS_PASSWORD>
REDIS_PORT=6379
REDIS_MAXMEMORY=400mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Redis Performance (t3.medium optimized)
REDIS_CPUS=0.5
REDIS_MEMORY_LIMIT=400m
REDIS_MEMORY_RESERVATION=200m

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET_KEY=<CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_32_CHARS>
JWT_ISSUER=StarterKit.API
JWT_AUDIENCE=StarterKit.Client
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ==============================================
# SEQ LOGGING
# ==============================================
SEQ_PORT=5341
SEQ_ACCEPT_EULA=Y
# echo 'YourPassword' | docker run --rm -i datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=<CHANGE_ME_SEQ_PASSWORD_HASH>
SEQ_CPUS=0.5
SEQ_MEMORY_LIMIT=400m
SEQ_MEMORY_RESERVATION=200m

# ==============================================
# API CONFIGURATION
# ==============================================
# Port mappings for API replicas
API_HTTP_PORT_1=5000
API_HTTP_PORT_2=5001
API_PORT=5000

# Resource limits (t3.medium optimized)
API_REPLICAS=2
API_CPUS=0.8
API_MEMORY_LIMIT=600m
API_MEMORY_RESERVATION=300m

# ==============================================
# HANGFIRE DASHBOARD
# ==============================================
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=<CHANGE_ME_HANGFIRE_PASSWORD>

# ==============================================
# OPENTELEMETRY
# ==============================================
OTEL_SERVICE_NAME=starterkit-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ==============================================
# NGINX CONFIGURATION (Docker - if using containerized)
# ==============================================
# Note: For hybrid approach, Nginx is installed on host
# These settings are for reference if you need Docker Nginx
NGINX_SERVER_NAME=_
NGINX_CONFIG_FILE=app-production.conf
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CPUS=0.3
NGINX_MEMORY_LIMIT=200m
NGINX_MEMORY_RESERVATION=100m

# ==============================================
# OBSERVABILITY - PROMETHEUS
# ==============================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_CPUS=0.5
PROMETHEUS_MEMORY_LIMIT=300m
PROMETHEUS_MEMORY_RESERVATION=150m

# ==============================================
# OBSERVABILITY - GRAFANA
# ==============================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_GRAFANA_PASSWORD>
GRAFANA_ROOT_URL=https://api.example.com/grafana/
GRAFANA_CPUS=0.5
GRAFANA_MEMORY_LIMIT=300m
GRAFANA_MEMORY_RESERVATION=150m

# ==============================================
# OBSERVABILITY - TEMPO (Distributed Tracing)
# ==============================================
TEMPO_PORT=3200
TEMPO_CPUS=0.3
TEMPO_MEMORY_LIMIT=200m
TEMPO_MEMORY_RESERVATION=100m

# ==============================================
# OBSERVABILITY - JAEGER
# ==============================================
JAEGER_UI_PORT=16686
JAEGER_CPUS=0.3
JAEGER_MEMORY_LIMIT=200m
JAEGER_MEMORY_RESERVATION=100m

# ==============================================
# OBSERVABILITY - OTEL COLLECTOR
# ==============================================
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_CPUS=0.3
OTEL_COLLECTOR_MEMORY_LIMIT=200m
OTEL_COLLECTOR_MEMORY_RESERVATION=100m

# ==============================================
# HEALTH CHECK CONFIGURATION
# ==============================================
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=40s

# ==============================================
# PRODUCTION ADMIN TOOLS (Disabled by default)
# ==============================================
# Uncomment if you need these tools in production

# PgAdmin
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=<CHANGE_ME_PGADMIN_PASSWORD>
# PGADMIN_PORT=5050
# PGADMIN_CONFIG_SERVER_MODE=True

# Redis Commander
# REDIS_COMMANDER_PORT=8081

# ==============================================
# POSTGRESQL S3 BACKUP CONFIGURATION
# ==============================================
# S3 Bucket Configuration
S3_BACKUP_BUCKET=<CHANGE_ME_YOUR_BACKUP_BUCKET>
S3_BACKUP_PREFIX=database-backups
AWS_DEFAULT_REGION=us-east-1

# AWS Credentials for Backups
# SECURITY: Use separate IAM user with only S3 backup permissions
AWS_ACCESS_KEY_ID=<CHANGE_ME_AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<CHANGE_ME_AWS_SECRET_KEY>

# Backup Schedule (cron format or @daily, @weekly, @monthly)
BACKUP_SCHEDULE=@daily

# Retention Policy
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Resource Limits
BACKUP_MEMORY_LIMIT=512m
BACKUP_MEMORY_RESERVATION=256m
BACKUP_CPUS=0.5

# ==============================================
# NOTES
# ==============================================
# 1. Replace all <CHANGE_ME_*> values with strong passwords
# 2. JWT_SECRET_KEY should be at least 32 characters, random
# 3. Database passwords should be complex (uppercase, lowercase, numbers, symbols)
# 4. Never expose database/redis ports externally in production
# 5. Monitoring dashboards should be IP-restricted in Nginx config
#
# Password generation examples:
#   openssl rand -base64 32
#   pwgen -s 32 1
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
