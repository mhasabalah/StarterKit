# ==============================================
# pgBackRest Configuration Template
# ==============================================
# This template is processed by the entrypoint script
# Placeholders are replaced with environment variable values
# ==============================================

# ==============================================
# Stanza: starterkit
# ==============================================
[starterkit]
pg1-path=/var/lib/postgresql/data/pgdata
pg1-socket-path=/var/run/postgresql
pg1-port=5432
pg1-user={{POSTGRES_USER}}

# ==============================================
# Global Configuration
# ==============================================
[global]
# General options
log-level-console=info
log-level-file=debug
start-fast=y

# Repository 1 (S3)
repo1-type=s3
repo1-s3-bucket={{S3_BACKUP_BUCKET}}
repo1-s3-endpoint=s3.{{AWS_DEFAULT_REGION}}.amazonaws.com
repo1-s3-key={{AWS_ACCESS_KEY_ID}}
repo1-s3-key-secret={{AWS_SECRET_ACCESS_KEY}}
repo1-s3-region={{AWS_DEFAULT_REGION}}
repo1-s3-uri-style=host
repo1-path=/pgbackrest
repo1-storage-port=443
repo1-storage-verify-tls=y
repo1-retention-full=4
repo1-retention-diff=8

# Compression
compress-type=lz4
compress-level=3

# Performance
process-max=4
archive-async=y
archive-push-queue-max=1073741824
archive-get-queue-max=1073741824
stop-auto=y

# Logging
log-path=/var/log/pgbackrest
spool-path=/var/spool/pgbackrest
