<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet config: restore only from nuget.org so the template builds the same on every
  machine/CI, independent of user-level private feeds. Add private feeds here explicitly if a project needs them.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
