# ==============================================
# Nginx Environment Variables
# ==============================================

# Server Configuration
NGINX_SERVER_NAME=localhost
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=2048

# Ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# SSL Configuration (Production)
NGINX_SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Rate Limiting (requests per second)
NGINX_API_RATE_LIMIT=100
NGINX_AUTH_RATE_LIMIT=10
NGINX_GENERAL_RATE_LIMIT=50

# Cache Configuration
NGINX_CACHE_MAX_SIZE=100m
NGINX_CACHE_INACTIVE=60m

# Timeouts (seconds)
NGINX_PROXY_CONNECT_TIMEOUT=60
NGINX_PROXY_SEND_TIMEOUT=60
NGINX_PROXY_READ_TIMEOUT=60

# Client Configuration
NGINX_CLIENT_MAX_BODY_SIZE=50M
NGINX_CLIENT_BODY_TIMEOUT=12
NGINX_CLIENT_HEADER_TIMEOUT=12

# Logging
NGINX_ACCESS_LOG_FORMAT=json_logs
NGINX_ERROR_LOG_LEVEL=warn
