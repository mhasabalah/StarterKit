{% comment %}Variables: SubscriberName, PlanName, Amount, Currency, TransactionRef, SupportWhatsApp, SupportEmail{% endcomment %}

<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#0f172a;line-height:1.35;">
  {% if culture == 'ar' %}تم صرف مبلغ الاسترداد{% else %}Refund Processed{% endif %}
</h2>

<p style="margin:0 0 20px 0;font-size:15px;color:#4b5563;line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:#0f172a;">{{ SubscriberName }}</strong>، تم صرف مبلغ الاسترداد بنجاح.
  {% else %}
    Hello <strong style="color:#0f172a;">{{ SubscriberName }}</strong>, your refund has been successfully processed.
  {% endif %}
</p>

{% capture card_content %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding:5px 0;font-size:13px;color:#64748b;width:160px;">{% if culture == 'ar' %}الخطة{% else %}Plan{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:#0f172a;">{{ PlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:#64748b;">{% if culture == 'ar' %}المبلغ المسترد{% else %}Refunded Amount{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:#16a34a;">{{ Amount }} {{ Currency }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:#64748b;">{% if culture == 'ar' %}رقم المعاملة{% else %}Transaction Ref{% endif %}</td>
    <td style="padding:5px 0;font-size:13px;color:#64748b;">{{ TransactionRef }}</td>
  </tr>
</table>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'تفاصيل الاسترداد' %}{% else %}{% assign card_title = 'Refund Details' %}{% endif %}
{% include 'Components/Card' %}

{% include 'Components/Spacer' %}

<p style="margin:0;font-size:13px;color:#94a3b8;text-align:center;">
  {% if culture == 'ar' %}
    للاستفسار تواصل معنا عبر واتساب: <strong style="color:#374151;">{{ SupportWhatsApp }}</strong> أو البريد الإلكتروني: <strong style="color:#374151;">{{ SupportEmail }}</strong>
  {% else %}
    For questions, contact us on WhatsApp: <strong style="color:#374151;">{{ SupportWhatsApp }}</strong> or email: <strong style="color:#374151;">{{ SupportEmail }}</strong>
  {% endif %}
</p>
