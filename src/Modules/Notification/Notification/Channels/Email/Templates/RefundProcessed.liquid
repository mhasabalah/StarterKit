{% comment %}Variables: SubscriberName, PlanName, Amount, Currency, TransactionRef, SupportWhatsApp, SupportEmail{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}تم صرف مبلغ الاسترداد{% else %}Refund Processed{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>، تم صرف مبلغ الاسترداد بنجاح.
  {% else %}
    Hello <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>, your refund has been successfully processed.
  {% endif %}
</p>

{% capture card_content %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};width:160px;">{% if culture == 'ar' %}الخطة{% else %}Plan{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ PlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}المبلغ المسترد{% else %}Refunded Amount{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.success }};">{{ Amount }} {{ Currency }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}رقم المعاملة{% else %}Transaction Ref{% endif %}</td>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{{ TransactionRef }}</td>
  </tr>
</table>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'تفاصيل الاسترداد' %}{% else %}{% assign card_title = 'Refund Details' %}{% endif %}
{% include 'Components/Card' %}

{% include 'Components/Spacer' %}

<p class="sk-p" style="margin:0;font-size:13px;color:{{ t.textSubtle }};text-align:center;">
  {% if culture == 'ar' %}
    للاستفسار تواصل معنا عبر واتساب: <strong style="color:{{ t.textBody }};">{{ SupportWhatsApp }}</strong> أو البريد الإلكتروني: <strong style="color:{{ t.textBody }};">{{ SupportEmail }}</strong>
  {% else %}
    For questions, contact us on WhatsApp: <strong style="color:{{ t.textBody }};">{{ SupportWhatsApp }}</strong> or email: <strong style="color:{{ t.textBody }};">{{ SupportEmail }}</strong>
  {% endif %}
</p>
