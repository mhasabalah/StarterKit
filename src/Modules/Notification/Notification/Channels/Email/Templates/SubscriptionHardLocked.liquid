{% comment %}Variables: SubscriberName, SupportEmail{% endcomment %}

<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#0f172a;line-height:1.35;">
  {% if culture == 'ar' %}تم تجميد الحساب{% else %}Account Locked{% endif %}
</h2>

<p style="margin:0 0 20px 0;font-size:15px;color:#4b5563;line-height:1.75;">
  {% if culture == 'ar' %}
    تم تجميد حساب <strong style="color:#0f172a;">{{ SubscriberName }}</strong> بسبب انتهاء الاشتراك وعدم التجديد خلال فترة السماح.
  {% else %}
    The account for <strong style="color:#0f172a;">{{ SubscriberName }}</strong> has been locked due to an expired subscription and no renewal during the grace period.
  {% endif %}
</p>

{% assign alert_type = 'danger' %}
{% assign alert_text_en = 'All platform access has been suspended. Please contact support to restore your account.' %}
{% assign alert_text_ar = 'تم تعليق جميع صلاحيات الوصول إلى المنصة. يُرجى التواصل مع الدعم لاستعادة حسابك.' %}
{% include 'Components/Alert' %}

{% capture card_content %}
<p style="margin:0;font-size:14px;color:#64748b;">
  {% if culture == 'ar' %}للتواصل مع فريق الدعم{% else %}Reach our support team at{% endif %}
</p>
<a href="mailto:{{ SupportEmail }}"
   style="display:inline-block;margin-top:6px;font-size:15px;font-weight:600;color:#1a1a2e;text-decoration:none;">
  {{ SupportEmail }}
</a>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'الدعم الفني' %}{% else %}{% assign card_title = 'Support' %}{% endif %}
{% include 'Components/Card' %}
