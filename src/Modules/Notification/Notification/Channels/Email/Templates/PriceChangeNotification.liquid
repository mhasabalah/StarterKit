{% comment %}Variables: SubscriberName, PlanName, OldPrice, NewPrice, Currency, EffectiveAt, DaysUntilEffective, PortalUrl{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}إشعار بتغيير سعر الاشتراك{% else %}Subscription Price Change Notice{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>، نودّ إعلامكم بتغيير سعر خطة <strong>{{ PlanName }}</strong>.
  {% else %}
    Hello <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>, we're writing to inform you of an upcoming price change for the <strong>{{ PlanName }}</strong> plan.
  {% endif %}
</p>

{% capture card_content %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};width:160px;white-space:nowrap;">
      {% if culture == 'ar' %}السعر الحالي{% else %}Current Price{% endif %}
    </td>
    <td style="padding:5px 0;font-size:14px;color:{{ t.text }};">{{ OldPrice }} {{ Currency }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}السعر الجديد{% else %}New Price{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:700;color:{{ t.text }};">{{ NewPrice }} {{ Currency }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}تاريخ التطبيق{% else %}Effective Date{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.danger }};">{{ EffectiveAt }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}المتبقي{% else %}Days Remaining{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;color:{{ t.text }};">{{ DaysUntilEffective }} {% if culture == 'ar' %}يوم{% else %}days{% endif %}</td>
  </tr>
</table>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'تفاصيل التغيير' %}{% else %}{% assign card_title = 'Price Change Details' %}{% endif %}
{% include 'Components/Card' %}

<p class="sk-p" style="margin:16px 0;font-size:14px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    سيُطبَّق السعر الجديد عند تجديد اشتراكك بعد تاريخ التطبيق. لن يتأثر اشتراكك الحالي.
  {% else %}
    The new price will apply when your subscription renews on or after the effective date. Your current billing cycle is not affected.
  {% endif %}
</p>

{% assign button_url = PortalUrl %}
{% if culture == 'ar' %}{% assign button_text = 'إدارة الاشتراك' %}{% else %}{% assign button_text = 'Manage Subscription' %}{% endif %}
{% include 'Components/Button' %}
