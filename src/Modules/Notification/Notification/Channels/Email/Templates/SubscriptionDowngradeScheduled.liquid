{% comment %}Variables: SubscriberName, CurrentPlanName, NewPlanName, EffectiveAt, PortalUrl{% endcomment %}

<h2 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#0f172a;line-height:1.35;">
  {% if culture == 'ar' %}تم جدولة تخفيض اشتراكك{% else %}Downgrade Scheduled{% endif %}
</h2>

<p style="margin:0 0 20px 0;font-size:15px;color:#4b5563;line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:#0f172a;">{{ SubscriberName }}</strong>، تم جدولة تخفيض اشتراكك.
  {% else %}
    Hello <strong style="color:#0f172a;">{{ SubscriberName }}</strong>, your subscription downgrade has been scheduled.
  {% endif %}
</p>

{% capture card_content %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding:5px 0;font-size:13px;color:#64748b;width:140px;white-space:nowrap;">
      {% if culture == 'ar' %}الخطة الحالية{% else %}Current Plan{% endif %}
    </td>
    <td style="padding:5px 0;font-size:14px;color:#0f172a;">{{ CurrentPlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:#64748b;">{% if culture == 'ar' %}الخطة الجديدة{% else %}New Plan{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:#0f172a;">{{ NewPlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:#64748b;">{% if culture == 'ar' %}تاريخ التطبيق{% else %}Effective Date{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:#dc2626;">{{ EffectiveAt }}</td>
  </tr>
</table>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'تفاصيل التخفيض' %}{% else %}{% assign card_title = 'Downgrade Details' %}{% endif %}
{% include 'Components/Card' %}

{% assign button_url = PortalUrl %}
{% if culture == 'ar' %}{% assign button_text = 'إدارة الاشتراك' %}{% else %}{% assign button_text = 'Manage Subscription' %}{% endif %}
{% include 'Components/Button' %}
