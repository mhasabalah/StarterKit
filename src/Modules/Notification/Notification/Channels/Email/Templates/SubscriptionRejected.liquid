{% comment %}Variables: SubscriberName, PlanName, RejectionReason, SupportWhatsApp, SupportEmail{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.danger }};line-height:1.35;">
  {% if culture == 'ar' %}تم رفض طلب الاشتراك{% else %}Subscription Request Rejected{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>، نأسف لإبلاغك بأن طلب الاشتراك في خطة <strong>{{ PlanName }}</strong> قد تم رفضه.
  {% else %}
    Hello <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>, we're sorry to inform you that your subscription request for the <strong>{{ PlanName }}</strong> plan has been rejected.
  {% endif %}
</p>

{% if RejectionReason != '' %}
{% capture card_content %}
<p class="sk-p" style="margin:0;font-size:14px;color:{{ t.textBody }};line-height:1.75;">{{ RejectionReason }}</p>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'سبب الرفض' %}{% else %}{% assign card_title = 'Reason for Rejection' %}{% endif %}
{% include 'Components/Card' %}
{% endif %}

{% assign alert_type = 'warning' %}
{% assign alert_text_en = 'If you believe this is an error or would like to appeal, please contact our support team.' %}
{% assign alert_text_ar = 'إذا كنت تعتقد أن هذا خطأ أو تريد الاعتراض، يُرجى التواصل مع فريق الدعم.' %}
{% include 'Components/Alert' %}

{% include 'Components/Spacer' %}

<p class="sk-p" style="margin:0;font-size:13px;color:{{ t.textSubtle }};text-align:center;">
  {% if culture == 'ar' %}
    للمساعدة تواصل معنا عبر واتساب: <strong style="color:{{ t.textBody }};">{{ SupportWhatsApp }}</strong> أو البريد الإلكتروني: <strong style="color:{{ t.textBody }};">{{ SupportEmail }}</strong>
  {% else %}
    Contact us on WhatsApp: <strong style="color:{{ t.textBody }};">{{ SupportWhatsApp }}</strong> or email: <strong style="color:{{ t.textBody }};">{{ SupportEmail }}</strong>
  {% endif %}
</p>
