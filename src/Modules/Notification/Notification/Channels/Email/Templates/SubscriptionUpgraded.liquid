{% comment %}Variables: SubscriberName, OldPlanName, NewPlanName, ProratedAmount, Currency, IsDeferred, PortalUrl{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}تمت ترقية اشتراكك{% else %}Your Subscription Has Been Upgraded{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>، تمت ترقية اشتراكك بنجاح.
  {% else %}
    Hello <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>, your subscription has been successfully upgraded.
  {% endif %}
</p>

{% capture card_content %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};width:140px;white-space:nowrap;">
      {% if culture == 'ar' %}من الخطة{% else %}From Plan{% endif %}
    </td>
    <td style="padding:5px 0;font-size:14px;color:{{ t.text }};">{{ OldPlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}إلى الخطة{% else %}To Plan{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.success }};">{{ NewPlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}مبلغ التسوية{% else %}Proration{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ ProratedAmount }} {{ Currency }}</td>
  </tr>
</table>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'تفاصيل الترقية' %}{% else %}{% assign card_title = 'Upgrade Details' %}{% endif %}
{% include 'Components/Card' %}

{% assign button_url = PortalUrl %}
{% if culture == 'ar' %}{% assign button_text = 'عرض الاشتراك' %}{% else %}{% assign button_text = 'View Subscription' %}{% endif %}
{% include 'Components/Button' %}
