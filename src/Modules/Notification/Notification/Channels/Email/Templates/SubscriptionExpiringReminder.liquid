{% comment %}Variables: SubscriberName, PlanName, ExpiryDate, RenewalUrl{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}تذكير: اشتراكك على وشك الانتهاء{% else %}Subscription Expiry Reminder{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>، اشتراك خطة <strong>{{ PlanName }}</strong> على وشك الانتهاء.
  {% else %}
    Hello <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>, your <strong>{{ PlanName }}</strong> plan is expiring soon.
  {% endif %}
</p>

{% capture card_content %}
<p class="sk-p" style="margin:0;font-size:14px;color:{{ t.textMuted }};">
  {% if culture == 'ar' %}تاريخ انتهاء الاشتراك{% else %}Subscription expiry date{% endif %}
</p>
<p class="sk-p" style="margin:6px 0 0 0;font-size:17px;font-weight:700;color:{{ t.warning }};">{{ ExpiryDate }}</p>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'موعد الانتهاء' %}{% else %}{% assign card_title = 'Expiry Date' %}{% endif %}
{% include 'Components/Card' %}

{% assign alert_type = 'info' %}
{% assign alert_text_en = 'Renew before the expiry date to keep uninterrupted access to all features.' %}
{% assign alert_text_ar = 'جدّد قبل تاريخ الانتهاء للإبقاء على وصول متواصل لجميع الميزات.' %}
{% include 'Components/Alert' %}

{% assign button_url = RenewalUrl %}
{% if culture == 'ar' %}{% assign button_text = 'تجديد الاشتراك' %}{% else %}{% assign button_text = 'Renew Subscription' %}{% endif %}
{% include 'Components/Button' %}
