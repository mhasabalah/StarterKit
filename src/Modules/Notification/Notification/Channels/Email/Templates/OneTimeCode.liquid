{% comment %}
  Variables: Code, Purpose (email_verification | sign_in), ExpiresInMinutes
  The code is never in the subject or the preheader (lock screens show both).
{% endcomment %}
{% if culture == 'ar' %}
  {% if Purpose == 'sign_in' %}{% assign heading_text = 'رمز تسجيل الدخول' %}{% else %}{% assign heading_text = 'تأكيد بريدك الإلكتروني' %}{% endif %}
  {% assign text_content = 'استخدم الرمز التالي لإكمال العملية:' %}
  {% assign code_caption = 'ينتهي خلال ' | append: ExpiresInMinutes | append: ' دقيقة' %}
  {{ 'رمز التحقق الخاص بك جاهز' | set_preheader }}
{% else %}
  {% if Purpose == 'sign_in' %}{% assign heading_text = 'Your sign-in code' %}{% else %}{% assign heading_text = 'Confirm your email address' %}{% endif %}
  {% assign text_content = 'Enter this code to continue:' %}
  {% assign code_caption = 'Expires in ' | append: ExpiresInMinutes | append: ' minutes' %}
  {{ 'Your verification code is inside' | set_preheader }}
{% endif %}
{% include 'Components/Heading' %}
{% include 'Components/Text' %}

{% assign code_value = Code %}
{% include 'Components/CodeBlock' %}

{% assign alert_type = 'info' %}
{% assign alert_text_en = 'We will never ask you for this code. If you did not request it, ignore this email - your account is safe.' %}
{% assign alert_text_ar = 'لن نطلب منك هذا الرمز أبداً. إذا لم تطلبه فتجاهل هذه الرسالة - حسابك آمن.' %}
{% include 'Components/Alert' %}
