{% comment %}Variables: SubscriberName, NewPlanName, NewRenewalDate, PortalUrl{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}تم تطبيق خطتك الجديدة{% else %}Plan Updated — Subscription Renewed{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>، تم تجديد اشتراكك وتطبيق خطة {{ NewPlanName }}.
  {% else %}
    Hello <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong>, your subscription has been renewed and updated to the <strong>{{ NewPlanName }}</strong> plan.
  {% endif %}
</p>

{% capture card_content %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};width:140px;white-space:nowrap;">
      {% if culture == 'ar' %}الخطة الجديدة{% else %}New Plan{% endif %}
    </td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.success }};">{{ NewPlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}تاريخ التجديد{% else %}Next Renewal{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ NewRenewalDate }}</td>
  </tr>
</table>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'تفاصيل الاشتراك' %}{% else %}{% assign card_title = 'Subscription Details' %}{% endif %}
{% include 'Components/Card' %}

{% assign button_url = PortalUrl %}
{% if culture == 'ar' %}{% assign button_text = 'عرض الاشتراك' %}{% else %}{% assign button_text = 'View Subscription' %}{% endif %}
{% include 'Components/Button' %}
