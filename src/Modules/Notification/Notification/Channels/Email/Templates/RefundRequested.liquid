{% comment %}Variables: SubscriberName, PlanName, Amount, Currency, RefundType{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}طلب استرداد جديد{% else %}New Refund Request{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    قدّم المطوّر <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong> طلب استرداد. يرجى المراجعة والبت في الطلب في أقرب وقت.
  {% else %}
    Subscriber <strong style="color:{{ t.text }};">{{ SubscriberName }}</strong> has submitted a refund request. Please review and take action promptly.
  {% endif %}
</p>

{% capture card_content %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};width:160px;">{% if culture == 'ar' %}الخطة{% else %}Plan{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ PlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}المبلغ{% else %}Amount{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ Amount }} {{ Currency }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}النوع{% else %}Type{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;color:{{ t.text }};">{{ RefundType }}</td>
  </tr>
</table>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'تفاصيل الاسترداد' %}{% else %}{% assign card_title = 'Refund Details' %}{% endif %}
{% include 'Components/Card' %}
