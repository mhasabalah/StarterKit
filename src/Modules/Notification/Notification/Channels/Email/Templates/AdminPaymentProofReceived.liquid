{% comment %}Variables: SubscriberName, ApplicantEmail, PlanName, ProofUploadedAt, AdminReviewUrl{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}إثبات دفع جديد بانتظار المراجعة{% else %}New Payment Proof Awaiting Review{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    رفع المطوّر إثبات دفع جديداً وهو بانتظار مراجعتك وإجراء اللازم.
  {% else %}
    A subscriber has uploaded a new payment proof and it is awaiting your review.
  {% endif %}
</p>

{% capture card_content %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};width:130px;white-space:nowrap;">
      {% if culture == 'ar' %}الشركة{% else %}Company{% endif %}
    </td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ SubscriberName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}البريد الإلكتروني{% else %}Email{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ ApplicantEmail }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}الخطة{% else %}Plan{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ PlanName }}</td>
  </tr>
  <tr>
    <td style="padding:5px 0;font-size:13px;color:{{ t.textMuted }};">{% if culture == 'ar' %}وقت الرفع{% else %}Uploaded At{% endif %}</td>
    <td style="padding:5px 0;font-size:14px;font-weight:600;color:{{ t.text }};">{{ ProofUploadedAt }}</td>
  </tr>
</table>
{% endcapture %}
{% if culture == 'ar' %}{% assign card_title = 'تفاصيل الدفع' %}{% else %}{% assign card_title = 'Payment Details' %}{% endif %}
{% include 'Components/Card' %}

{% assign button_url = AdminReviewUrl %}
{% if culture == 'ar' %}{% assign button_text = 'مراجعة وإجراء اللازم' %}{% else %}{% assign button_text = 'Review & Take Action' %}{% endif %}
{% include 'Components/Button' %}
