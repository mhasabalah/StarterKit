<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
{% comment %}
  StarterKit email design system - base layout (v2)
  ───────────────────────────────────────────────────────────────────────────
  Every color, size and radius comes from the design tokens (t.*), defined once in EmailDesignTokens.cs and
  brandable through Email:Theme. Supports: light + dark scheme (Apple Mail, iOS, Outlook.com, Outlook app),
  RTL (dir), logo or text brand, per-template preheader ({{ 'Preview text' | set_preheader }}), footer links.
  Classes prefixed "sk-" exist ONLY to re-color in dark mode; inline styles carry the light scheme.
{% endcomment %}
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:v="urn:schemas-microsoft-com:vml"
      xmlns:o="urn:schemas-microsoft-com:office:office"
      lang="{{ culture }}" dir="{{ dir }}">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>{{ brandName }}</title>
  <!--[if mso]>
  <noscript><xml><o:OfficeDocumentSettings>
    <o:PixelsPerInch>96</o:PixelsPerInch>
  </o:OfficeDocumentSettings></xml></noscript>
  <![endif]-->
  <style type="text/css">
    /* ── Reset ─────────────────────────────────────────── */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; }
    body { margin: 0 !important; padding: 0 !important; width: 100% !important; }
    a { color: {{ t.accent }}; }
    :root { color-scheme: light dark; supported-color-schemes: light dark; }

    /* ── Base typography ────────────────────────────────── */
    body {
      background-color: {{ t.bg }};
      font-family: {% if culture == 'ar' %}{{ t.fontFamilyAr }}{% else %}{{ t.fontFamily }}{% endif %};
      font-size: {{ t.fontSizeBase }};
      line-height: {{ t.lineHeight }};
      color: {{ t.textBody }};
    }

    /* ── Responsive ─────────────────────────────────────── */
    @media only screen and (max-width: 620px) {
      .outer-wrap  { padding: 0 !important; }
      .email-card  { border-radius: 0 !important; width: 100% !important; }
      .header-cell { padding: 22px 20px !important; }
      .body-cell   { padding: 28px 20px !important; }
      .footer-cell { padding: 20px !important; }
      h1, h2       { font-size: 20px !important; line-height: 1.35 !important; }
      .btn-link    { display: block !important; width: auto !important; text-align: center !important; }
      .sk-code     { font-size: 24px !important; letter-spacing: 6px !important; }
    }

    /* ── Dark scheme (tokens: t.dark*) ──────────────────── */
    @media (prefers-color-scheme: dark) {
      .sk-bg, body { background-color: {{ t.darkBg }} !important; }
      .sk-card, .sk-body { background-color: {{ t.darkSurface }} !important; border-color: {{ t.darkBorder }} !important; }
      .sk-footer { background-color: {{ t.darkBg }} !important; border-color: {{ t.darkBorder }} !important; }
      .sk-h, .sk-body h1, .sk-body h2, .sk-body strong { color: {{ t.darkText }} !important; }
      .sk-p, .sk-body p, .sk-body li { color: {{ t.darkTextBody }} !important; }
      .sk-muted, .sk-footer p { color: {{ t.darkTextMuted }} !important; }
      .sk-box, .sk-code { background-color: {{ t.darkSurfaceMuted }} !important; border-color: {{ t.darkBorder }} !important; }
      .sk-box div, .sk-box td, .sk-code { color: {{ t.darkText }} !important; }
    }
    /* Outlook.com dark mode */
    [data-ogsc] .sk-h, [data-ogsc] .sk-body h2, [data-ogsc] .sk-body strong { color: {{ t.darkText }} !important; }
    [data-ogsc] .sk-p, [data-ogsc] .sk-body p { color: {{ t.darkTextBody }} !important; }
    [data-ogsb] .sk-card, [data-ogsb] .sk-body { background-color: {{ t.darkSurface }} !important; }
    [data-ogsb] .sk-box, [data-ogsb] .sk-code { background-color: {{ t.darkSurfaceMuted }} !important; }
  </style>
</head>
<body class="sk-bg" style="margin:0;padding:0;background-color:{{ t.bg }};">

  <!-- Preheader: the inbox preview line (hidden in the body) -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:{{ t.bg }};opacity:0;">
    {% if preheader != '' %}{{ preheader }}{% else %}{{ brandName }}{% endif %}
    &zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
  </div>

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
         class="outer-wrap sk-bg" style="background-color:{{ t.bg }};">
    <tr>
      <td align="center" style="padding:{{ t.space10 }} {{ t.space4 }};" class="outer-wrap">

        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" align="center"
               class="email-card sk-card"
               style="max-width:600px;width:100%;background:{{ t.surface }};border-radius:{{ t.radiusLg }};
                      overflow:hidden;border:1px solid {{ t.border }};">

          <!-- HEADER -->
          <tr>
            <td class="header-cell" dir="{{ dir }}"
                style="background-color:{{ t.brand }};padding:26px {{ t.space10 }};text-align:{{ align }};">
              {% if logoUrl != '' %}
                <img src="{{ logoUrl | safe_url }}" width="{{ logoWidth }}" alt="{{ brandName }}"
                     style="width:{{ logoWidth }}px;max-width:100%;height:auto;color:{{ t.onBrand }};font-size:20px;font-weight:700;" />
              {% else %}
                <span style="font-size:20px;font-weight:700;color:{{ t.onBrand }};letter-spacing:0.3px;">{{ brandName }}</span>
              {% endif %}
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td class="body-cell sk-body" dir="{{ dir }}"
                style="background-color:{{ t.surface }};padding:{{ t.space10 }};text-align:{{ align }};">
              {{ content | raw }}
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td class="footer-cell sk-footer" dir="{{ dir }}"
                style="background-color:{{ t.surfaceMuted }};padding:{{ t.space6 }} {{ t.space10 }};
                       border-top:1px solid {{ t.border }};text-align:center;">
              <p style="margin:0 0 6px 0;font-size:{{ t.fontSizeXs }};color:{{ t.textSubtle }};line-height:1.6;">
                {% if culture == 'ar' %}هذه الرسالة مُرسَلة تلقائيًا — يُرجى عدم الرد عليها.{% else %}This is an automated message — please do not reply.{% endif %}
                {% if supportEmail != '' %}
                  {% if culture == 'ar' %}للمساعدة:{% else %}Need help?{% endif %}
                  <a href="mailto:{{ supportEmail }}" style="color:{{ t.textMuted }};">{{ supportEmail }}</a>
                {% endif %}
              </p>
              {% if helpCenterUrl != '' or privacyUrl != '' %}
              <p style="margin:0 0 6px 0;font-size:{{ t.fontSizeXs }};color:{{ t.textSubtle }};">
                {% if helpCenterUrl != '' %}<a href="{{ helpCenterUrl | safe_url }}" style="color:{{ t.textMuted }};">{% if culture == 'ar' %}مركز المساعدة{% else %}Help center{% endif %}</a>{% endif %}
                {% if helpCenterUrl != '' and privacyUrl != '' %} · {% endif %}
                {% if privacyUrl != '' %}<a href="{{ privacyUrl | safe_url }}" style="color:{{ t.textMuted }};">{% if culture == 'ar' %}الخصوصية{% else %}Privacy{% endif %}</a>{% endif %}
              </p>
              {% endif %}
              {% if companyAddress != '' %}
              <p style="margin:0 0 6px 0;font-size:{{ t.fontSizeXs }};color:{{ t.textSubtle }};">{{ companyAddress }}</p>
              {% endif %}
              <p style="margin:0;font-size:{{ t.fontSizeXs }};color:{{ t.textSubtle }};">
                &copy; {{ currentYear }} {{ brandName }}.
                {% if culture == 'ar' %}جميع الحقوق محفوظة.{% else %}All rights reserved.{% endif %}
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
