{% comment %}Variables: firstName{% endcomment %}

<h2 class="sk-h" style="margin:0 0 20px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}مرحباً بك في {{ brandName }}{% else %}Welcome to {{ brandName }}{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 16px 0;font-size:15px;color:{{ t.textBody }};line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:{{ t.text }};">{{ firstName }}</strong>،
  {% else %}
    Hi <strong style="color:{{ t.text }};">{{ firstName }}</strong>,
  {% endif %}
</p>

<p class="sk-p" style="margin:0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    نحن سعداء بانضمامك إلى <strong>{{ brandName }}</strong>. حسابك جاهز الآن ويمكنك البدء فوراً.
  {% else %}
    We're thrilled to have you on board. Your account is ready — welcome to <strong>{{ brandName }}</strong>.
  {% endif %}
</p>

{% include 'Components/Divider' %}

<p class="sk-p" style="margin:0;font-size:14px;color:{{ t.textMuted }};line-height:1.7;">
  {% if culture == 'ar' %}
    إذا كان لديك أي استفسار، فريقنا دائماً في خدمتك.
  {% else %}
    If you have any questions, our support team is always here to help.
  {% endif %}
</p>
