{% comment %}
  Card - highlighted data box
  Required: card_content (HTML built with a capture block)
  Optional: card_title (small uppercase label)
{% endcomment %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:{{ t.space5 }} 0;">
  <tr>
    <td class="sk-box" dir="{{ dir }}"
        style="background-color:{{ t.surfaceMuted }};border:1px solid {{ t.border }};border-radius:{{ t.radius }};padding:18px 22px;text-align:{{ align }};">
      {% if card_title %}
      <p class="sk-muted" style="margin:0 0 {{ t.space3 }} 0;font-size:11px;font-weight:700;color:{{ t.textMuted }};text-transform:uppercase;letter-spacing:0.08em;">{{ card_title }}</p>
      {% endif %}
      <div style="font-size:{{ t.fontSizeBase }};color:{{ t.textStrong }};line-height:{{ t.lineHeight }};">
        {{ card_content }}
      </div>
    </td>
  </tr>
</table>
