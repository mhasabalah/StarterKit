{% comment %}
  Alert - colored notice
  Required: alert_text_en, alert_text_ar
  Optional: alert_type = info (default) | success | warning | danger
  RTL: the tables carry dir, so the icon cell sits on the leading edge in both directions.
{% endcomment %}
{% if alert_type == 'success' %}
  {% assign _a_bg = t.successBg %}{% assign _a_border = t.successBorder %}{% assign _a_bar = t.success %}{% assign _a_color = t.successText %}{% assign _a_icon = '✓' %}
{% elsif alert_type == 'warning' %}
  {% assign _a_bg = t.warningBg %}{% assign _a_border = t.warningBorder %}{% assign _a_bar = t.warning %}{% assign _a_color = t.warningText %}{% assign _a_icon = '!' %}
{% elsif alert_type == 'danger' %}
  {% assign _a_bg = t.dangerBg %}{% assign _a_border = t.dangerBorder %}{% assign _a_bar = t.danger %}{% assign _a_color = t.dangerText %}{% assign _a_icon = '✕' %}
{% else %}
  {% assign _a_bg = t.infoBg %}{% assign _a_border = t.infoBorder %}{% assign _a_bar = t.info %}{% assign _a_color = t.infoText %}{% assign _a_icon = 'i' %}
{% endif %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:{{ t.space4 }} 0;" dir="{{ dir }}">
  <tr>
    <td style="background-color:{{ _a_bg }};border:1px solid {{ _a_border }};border-radius:{{ t.radius }};padding:13px {{ t.space4 }};">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" dir="{{ dir }}">
        <tr>
          <td width="26" style="vertical-align:top;padding-top:2px;">
            <span style="display:inline-block;width:18px;height:18px;border-radius:50%;background-color:{{ _a_bar }};
                         color:{{ t.onBrand }};font-size:11px;font-weight:700;text-align:center;line-height:18px;font-style:normal;">{{ _a_icon }}</span>
          </td>
          <td style="vertical-align:top;font-size:{{ t.fontSizeSm }};color:{{ _a_color }};line-height:1.6;text-align:{{ align }};">
            {% if culture == 'ar' %}{{ alert_text_ar }}{% else %}{{ alert_text_en }}{% endif %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
