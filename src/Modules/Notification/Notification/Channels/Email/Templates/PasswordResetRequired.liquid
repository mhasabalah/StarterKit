{% comment %}Variables: ResetUrl, ExpiresInHours{% endcomment %}

<h2 class="sk-h" style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:{{ t.text }};line-height:1.35;">
  {% if culture == 'ar' %}طلب إعادة تعيين كلمة المرور{% else %}Password Reset Required{% endif %}
</h2>

<p class="sk-p" style="margin:0 0 20px 0;font-size:15px;color:{{ t.textSecondary }};line-height:1.75;">
  {% if culture == 'ar' %}
    مرحباً <strong style="color:{{ t.text }};">{{ brandName }}</strong>، رصدنا نشاطاً أمنياً يستوجب إعادة تعيين كلمة المرور. انقر على الزر أدناه للمتابعة.
  {% else %}
    Hello <strong style="color:{{ t.text }};">{{ brandName }}</strong>, a security event was detected on your account. Click the button below to reset your password.
  {% endif %}
</p>

{% assign button_url = ResetUrl %}
{% assign button_variant = 'danger' %}
{% if culture == 'ar' %}{% assign button_text = 'إعادة تعيين كلمة المرور' %}{% else %}{% assign button_text = 'Reset My Password' %}{% endif %}
{% include 'Components/Button' %}

{% assign alert_type = 'warning' %}
{% if culture == 'ar' %}
  {% assign alert_text_ar = 'ينتهي هذا الرابط خلال ' | append: ExpiresInHours | append: ' ساعة. إذا لم تطلب إعادة التعيين فتجاهل هذه الرسالة.' %}
  {% assign alert_text_en = alert_text_ar %}
{% else %}
  {% assign alert_text_en = 'This link expires in ' | append: ExpiresInHours | append: ' hours. If you did not request a reset, you can safely ignore this email.' %}
  {% assign alert_text_ar = alert_text_en %}
{% endif %}
{% include 'Components/Alert' %}
