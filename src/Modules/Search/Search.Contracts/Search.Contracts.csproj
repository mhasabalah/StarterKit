<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Thin, engine-neutral contract: Shared.Contracts only (no Shared.Core, no search engine client; architecture
             tests). Owning modules reference this project to plug in an index; they never see an engine. -->
        <ProjectReference Include="..\..\..\Shared\Shared.Contracts\Shared.Contracts.csproj" />
        <!-- IServiceCollection for the registration helper (AddSearchIndex). -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

</Project>
