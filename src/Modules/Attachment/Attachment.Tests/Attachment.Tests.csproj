<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Attachment module tests.
      - Unit/: validation, access policies, pending sessions, Local storage contract, download authorization,
        DB/blob consistency (fakes + real Local storage in a temp folder).
      - Integration/: real PostgreSQL via Testcontainers (Docker required).
    -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Moq" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="SkiaSharp" />
        <!-- Linux (Docker/CI) native library without fontconfig/freetype system dependencies. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Attachment\Attachment.csproj" />
        <ProjectReference Include="..\Attachment.Contracts\Attachment.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="FluentAssertions" />
    </ItemGroup>

</Project>
