{% comment %}
  Button Component
  ─────────────────────────────────────────────────────────
  Required variables:
    button_url      — href target
    button_text     — label text
  Optional variables:
    button_variant  — "primary" (default) | "success" | "danger" | "secondary"
  ─────────────────────────────────────────────────────────
{% endcomment %}
{% if button_variant == 'success' %}
  {% assign _bg    = '#059669' %}
  {% assign _color = '#ffffff' %}
{% elsif button_variant == 'danger' %}
  {% assign _bg    = '#dc2626' %}
  {% assign _color = '#ffffff' %}
{% elsif button_variant == 'secondary' %}
  {% assign _bg    = '#f1f5f9' %}
  {% assign _color = '#334155' %}
{% else %}
  {% assign _bg    = '#1a1a2e' %}
  {% assign _color = '#ffffff' %}
{% endif %}

<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0;">
  <tr>
    <td align="{% if culture == 'ar' %}right{% else %}left{% endif %}"
        style="border-radius:8px;background-color:{{ _bg }};">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml"
                   xmlns:w="urn:schemas-microsoft-com:office:word"
                   href="{{ button_url }}"
                   style="height:44px;v-text-anchor:middle;width:220px;"
                   arcsize="18%"
                   strokecolor="{{ _bg }}"
                   fillcolor="{{ _bg }}">
        <w:anchorlock/>
        <center style="color:{{ _color }};font-family:sans-serif;font-size:14px;font-weight:700;">{{ button_text }}</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{ button_url }}"
         target="_blank"
         class="btn-link"
         style="background-color:{{ _bg }};
                border-radius:8px;
                color:{{ _color }};
                display:inline-block;
                font-family:inherit;
                font-size:14px;
                font-weight:700;
                line-height:44px;
                min-width:180px;
                padding:0 28px;
                text-align:center;
                text-decoration:none;
                -webkit-text-size-adjust:none;
                mso-hide:all;">{{ button_text }}</a>
      <!--<![endif]-->
    </td>
  </tr>
</table>
