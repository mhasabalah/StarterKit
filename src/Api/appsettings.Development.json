{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "starterkit": "Host=localhost;Port=5432;Database=starterkit;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "JwtSettings": {
    "SecretKey": "dev-only-insecure-jwt-secret-key-change-me-0123456789"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "LoginPolicy": {
    "RequirePhoneVerification": false,
    "RequireEmailVerification": false,
    "RequireProfileCompletion": false,
    "AllowPartialLogin": false
  },
  "Hangfire": {
    "DashboardAuth": {
      "Enabled": false
    }
  },
  "whatsapp_access_token": "DEV_TOKEN_OR_EMPTY",
  "whatsapp_phone_number_id": "DEV_PHONE_NUMBER_ID_OR_EMPTY",
  "RateLimiting": {
    "Policies": [
      {
        "Name": "upload",
        "PermitLimit": 100,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      {
        "Name": "create",
        "PermitLimit": 100,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      {
        "Name": "search",
        "PermitLimit": 200,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    ]
  }
}
