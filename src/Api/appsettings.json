  "WhatsApp": {
    "ApiVersion": "v25.0",
    "PhoneNumberId": "",
    "AccessToken": "",
    "Templates": {
      "PasswordResetRequired": {
        "MetaTemplateName": "password_reset_required",
        "LanguageCode": "ar",
        "BodyParameters": [
          "ResetLink"
        ]
      },
