{
  "AppOptions": {
    "Name": "starterkit"
  },
  "ConnectionStrings": {
    "starterkit": "Host=localhost;Port=5432;Database=starterkit;Username=postgres;Password=CHANGE_ME;Include Error Detail=true",
    "seq": "http://localhost:5341"
  },
  "Messaging": {
    "Transport": "InMemory",
    "PostgreSql": {
      "Schema": "transport",
      "CreateInfrastructure": true
    },
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "starterkit",
      "Password": "CHANGE_ME"
    },
    "Outbox": {
      "BatchSize": 100,
      "MaxAttempts": 10,
      "LeaseSeconds": 60,
      "SweepCron": "* * * * *",
      "RetentionDays": 7
    }
  },
  "Attachment": {
    "Pending": {
      "MaxUploadsPerSession": 20,
      "MaxUploadsPerMinute": 5,
      "ExpirationHours": 48,
      "CleanupIntervalHours": 6,
      "CleanupBatchSize": 100
    },
    "Storage": {
      "Provider": "Local",
      "Local": {
        "UploadPath": "uploads",
        "BaseUrl": "/uploads"
      },
      "AzureBlob": {
        "ConnectionString": null,
        "ContainerName": "attachments",
        "UsePublicAccess": false
      },
      "S3": {
        "AccessKeyId": "",
        "SecretAccessKey": "",
        "Region": "us-east-1",
        "BucketName": "",
        "UsePublicAccess": true,
        "CloudFrontDomain": null,
        "UseServerSideEncryption": true,
        "StorageClass": "STANDARD",
        "PresignedUrlExpirationMinutes": 60
      }
    },
    "Validation": {
      "MaxFileSizeBytes": 10485760,
      "MaxImageSizeBytes": 10485760,
      "MaxDocumentSizeBytes": 52428800,
      "MaxVideoSizeBytes": 104857600,
      "MaxAudioSizeBytes": 20971520,
      "AllowedExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".bmp",
        ".webp",
        ".pdf",
        ".doc",
        ".docx",
        ".xls",
        ".xlsx",
        ".ppt",
        ".pptx",
        ".txt",
        ".csv",
        ".json",
        ".xml",
        ".mp4",
        ".mpeg",
        ".quicktime",
        ".avi",
        ".mp3",
        ".wav",
        ".ogg"
      ],
      "AllowedImageTypes": [
        "image/jpeg",
        "image/png",
        "image/gif",
        "image/bmp",
        "image/webp"
      ],
      "AllowedDocumentTypes": [
        "application/pdf",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.ms-excel",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-powerpoint",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "text/plain",
        "text/csv",
        "application/json",
        "application/xml"
      ],
      "AllowedVideoTypes": [
        "video/mp4",
        "video/mpeg",
        "video/quicktime",
        "video/x-msvideo"
      ],
      "AllowedAudioTypes": [
        "audio/mpeg",
        "audio/mp3",
        "audio/wav",
        "audio/ogg"
      ],
      "EnableVirusScanning": false,
      "EnableContentVerification": true,
      "BlockedExtensions": [
        ".exe",
        ".dll",
        ".bat",
        ".cmd",
        ".sh",
        ".ps1",
        ".vbs",
        ".js"
      ]
    },
    "Image": {
      "EnableThumbnailGeneration": true,
      "ThumbnailWidth": 200,
      "ThumbnailHeight": 200,
      "ThumbnailQuality": 80,
      "EnableOptimization": true
    }
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
