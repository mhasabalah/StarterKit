{
  "LoadTest": {
    "Enabled": true
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "ForwardedHeaders": {
    "TrustPrivateNetworks": true
  },
  "Realtime": {
    "Transports": "WebSockets"
  },
  "HealthOptions": {
    "Enabled": true
  },
  "Redis": {
    "Host": "redis",
    "Password": ""
  },
  "Messaging": {
    "Transport": "PostgreSql",
    "RabbitMq": {
      "Host": "rabbitmq",
      "Password": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BotProtection": {
    "Enabled": false
  },
  "Identity": {
    "TwoFactor": {
      "RequiredForRoles": [ "LoadTestNoRole0", "LoadTestNoRole1", "LoadTestNoRole2" ]
    }
  },
  "Hangfire": {
    "DashboardAuth": {
      "Enabled": false,
      "Password": ""
    }
  },
  "Subscriptions": {
    "PaymentGateways": {
      "Stripe": {
        "ApiKey": "",
        "Secret": ""
      },
      "Paymob": {
        "ApiKey": "",
        "PublicKey": "",
        "Secret": ""
      }
    }
  },
  "RateLimiting": {
    "Policies": [
      { "Name": "upload", "PermitLimit": 1000000, "WindowSeconds": 60, "QueueLimit": 0 },
      { "Name": "create", "PermitLimit": 1000000, "WindowSeconds": 60, "QueueLimit": 0 },
      { "Name": "search", "PermitLimit": 1000000, "WindowSeconds": 60, "QueueLimit": 0 },
      { "Name": "auth", "PermitLimit": 1000000, "WindowSeconds": 60, "QueueLimit": 0, "PartitionBy": "Ip" },
      { "Name": "otp", "PermitLimit": 1000000, "WindowSeconds": 60, "QueueLimit": 0, "PartitionBy": "IpAndUser" }
    ],
    "Tenant": {
      "PermitLimit": 0
    }
  }
}
