{
  "ForwardedHeaders": {
    "TrustPrivateNetworks": true
  },
  "Realtime": {
    "Transports": "WebSockets"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "HealthOptions": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "seq": "http://seq:80"
  },
  "Messaging": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Password": ""
    }
  },
  //#if (storage != "Local")
  "Attachment": {
    "Storage": {
      //#if (storage == "AzureBlob")
      //"Provider": "AzureBlob"
      //#else
      //"Provider": "S3"
      //#endif
    }
  },
  //#endif
  "JwtSettings": {
    "Issuer": "StarterKitAPI",
    "Audience": "StarterKitClient",
    "AccessTokenExpirationMinutes": 15
  },
  "Redis": {
    "Host": "redis",
    "Port": 6379,
    "Password": "",
    "InstanceName": "StarterKit:",
    "Enabled": true,
    "AbortOnConnectFail": false,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "UseSsl": false,
    "Database": 0
  },
  "ObservabilityOptions": {
    "ServiceName": "StarterKit.API",
    "InstrumentationName": "StarterKit.API",
    "TracingEnabled": true,
    "MetricsEnabled": true,
    "LoggingEnabled": true,
    "UseOTLPExporter": false,
    "UsePrometheusExporter": true,
    "UseConsoleExporter": false,
    "UseJaegerExporter": false,
    "UseZipkinExporter": false,
    "UseGrafanaExporter": false,
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://otel-collector:4317"
    }
  },
  "Identity": {
    "Passkeys": {
      "ServerDomain": "example.com",
      "AllowedOrigins": [
        "https://app.example.com"
      ]
    },
    "Sso": {
      "PublicBaseUrl": "https://api.example.com",
      "AllowedReturnOrigins": [
        "https://app.example.com"
      ],
      "AllowInsecureIdentityProviders": false
    }
  }
}
