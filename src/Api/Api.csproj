<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
      <UserSecretsId>dec35037-53d5-4807-8d1f-8c6c298b62b4</UserSecretsId>
      <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
      <DockerfileContext>..\..</DockerfileContext>
      <DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- The load-test profile (rate limits and 2FA relaxed) is never part of a published image: the load-test
             compose file mounts it read-only. -->
        <Content Update="appsettings.LoadTest.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Seq" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
        <PackageReference Include="Hangfire.AspNetCore" />
        <PackageReference Include="Hangfire.PostgreSql" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Aspire\ServiceDefaults\ServiceDefaults.csproj" />
      <ProjectReference Include="..\Shared\Shared.Core\Shared.Core.csproj" />
    </ItemGroup>

    <!-- Modules (ADR-0019): every src/Modules/<M>/<M>/<M>.csproj is referenced by this glob, and each one becomes an
         [assembly: ModuleAssembly("<M>")] attribute that ModuleCatalog reads at startup. Adding a module = dropping
         its folder in; Program.cs never changes. Contracts and test projects are not modules. -->
    <ItemGroup>
      <ProjectReference Include="..\Modules\*\*\*.csproj"
                        Exclude="..\Modules\**\*.Contracts.csproj;..\Modules\**\*.Tests.csproj;..\Modules\**\*.IntegrationTests.csproj"
                        IsModule="true" />
    </ItemGroup>

    <!-- No Condition attribute here on purpose: `dotnet new` evaluates MSBuild conditions in project files as template
         conditions and would drop the element. WithMetadataValue filters the module references instead. -->
    <Target Name="AddModuleAssemblyAttributes" BeforeTargets="GetAssemblyAttributes">
      <ItemGroup>
        <_ModuleReference Include="@(ProjectReference->WithMetadataValue('IsModule', 'true'))" />
        <AssemblyAttribute Include="Shared.Core.Modularity.ModuleAssemblyAttribute">
          <_Parameter1>%(_ModuleReference.Filename)</_Parameter1>
        </AssemblyAttribute>
      </ItemGroup>
    </Target>

    <ItemGroup>
      <Folder Include="uploads\" />
    </ItemGroup>

</Project>
