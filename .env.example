# ==============================================
# StarterKit Environment Configuration
# ==============================================
# Copy this file to .env and adjust values for your environment
#
# PRODUCTION: Use with secrets in ./secrets/ directory
# DEVELOPMENT: Override will use direct environment variables
# ==============================================

# ==============================================
# Application Settings
# ==============================================
COMPOSE_PROJECT_NAME=starterkit
ASPNETCORE_ENVIRONMENT=Production
TZ=UTC
# Public domain served by Nginx (used in docs/nginx templates)
DOMAIN=api.example.com

# ==============================================
# CI/CD Settings (GitHub Actions)
# ==============================================
# GitHub repository (lowercase, format: owner/repo)
GITHUB_REPOSITORY=your-org/starterkit
# Image tag (set by CI: latest, v1.0.0, main-abc123)
IMAGE_TAG=latest
# Docker registry
DOCKER_REGISTRY=ghcr.io
# Full image name used by docker-compose.yml (api service)
DOCKER_IMAGE=ghcr.io/your-org/starterkit-api
DOCKER_IMAGE_TAG=latest

# ==============================================
# PostgreSQL Configuration
# ==============================================
POSTGRES_HOST=postgres
# Production: 5432 (bound to 127.0.0.1)
# Development: 5433 (to avoid conflict with local PostgreSQL)
POSTGRES_PORT=5433
POSTGRES_DB=starterkit
POSTGRES_USER=starterkit_user
# Production: Password in secrets/postgres_password.txt
# Development: Set password here (for docker-compose.override.yml)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_MAX_CONNECTIONS=200

# PostgreSQL Resource Limits
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_MEMORY_RESERVATION=1g
POSTGRES_CPUS=2.0

# ==============================================
# pgBackRest Backup Configuration
# ==============================================
# AWS S3 Bucket for Backups
S3_BACKUP_BUCKET=your-backup-bucket-name
AWS_DEFAULT_REGION=us-east-1

# AWS Credentials
# For production on EC2/ECS: Use IAM role (leave empty)
# For development or on-premise: Set these values
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Backup Schedule
# @daily = Incremental daily, Full on Sunday
# @weekly = Full backup weekly
# @monthly = Full backup monthly
# Or use cron format: "0 2 * * *" (daily at 2 AM)
BACKUP_SCHEDULE=@daily

# Notifications (optional)
# Webhook URL for backup notifications (Slack, Discord, etc.)
BACKUP_WEBHOOK_URL=

# Health Check
# Maximum age in hours before backup is considered stale
HEALTHCHECK_MAX_AGE_HOURS=25

# Resource Limits
BACKUP_MEMORY_LIMIT=512m
BACKUP_MEMORY_RESERVATION=256m
BACKUP_CPUS=0.5

# ==============================================
# PgAdmin Configuration (Development Only)
# ==============================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False

# ==============================================
# Redis Configuration
# ==============================================
REDIS_HOST=redis
# Production: 6379 (bound to 127.0.0.1)
# Development: 6380 (to avoid conflict with local Redis)
REDIS_PORT=6380
# Production: Password in secrets/redis_password.txt
# Development: Set password here (for docker-compose.override.yml)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Redis Resource Limits
REDIS_MEMORY_LIMIT=1g
REDIS_MEMORY_RESERVATION=512m
REDIS_CPUS=1.0

# ==============================================
# Messaging (MassTransit transport + outbox)
# ==============================================
# Options: PostgreSql (default, no extra infra) | RabbitMq | InMemory (dev/tests ONLY: not durable; the API refuses to
# boot with it outside Development/Testing)
# RabbitMq: the overlay docker-compose.rabbitmq.yml forces Transport=RabbitMq and starts the broker:
#   dev:  docker compose -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.rabbitmq.yml up -d
#   prod: docker compose -f docker-compose.yml -f docker-compose.rabbitmq.yml up -d
MESSAGING_TRANSPORT=PostgreSql

# ==============================================
# Database migrations (production compose runs a one-shot `migrator` service before the API)
# ==============================================
# Optional privileged (DDL) connection string used ONLY by the migrator is a Docker secret, NOT an env var (env vars
# leak via `docker inspect`): put it in secrets/migration_connection_string.txt (leave the file empty to migrate with
# the API connection). Example (keep out of git): Host=postgres;Database=starterkit;Username=starterkit_migrator;Password=...
RABBITMQ_USER=starterkit
# Development only (Development env skips Docker secrets). Production: leave EMPTY and use secrets/rabbitmq_password.txt
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================
# Seq Logging Configuration
# ==============================================
# Production: 5341 (bound to 127.0.0.1)
# Development: 5342 (to avoid conflict with local Seq)
SEQ_PORT=5342
# Production: Generate hash with:
# echo 'YourPassword' | docker run --rm -i datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=
SEQ_ACCEPT_EULA=Y

# Seq Resource Limits
SEQ_MEMORY_LIMIT=2g
SEQ_MEMORY_RESERVATION=1g
SEQ_CPUS=1.0

# ==============================================
# API Configuration
# ==============================================
# Production: 5000 (bound to 127.0.0.1; the deploy health checks use localhost:5000)
# Development: 5000. Pick another free port if 5000 is taken - but NOT 8888 (the OTel collector's metrics port).
API_PORT=5000

# Production: 2 replicas for zero-downtime
# Development: 1 replica (set in override)
API_REPLICAS=2

# API Resource Limits
API_MEMORY_LIMIT=2g
API_MEMORY_RESERVATION=1g
API_CPUS=2.0

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# ==============================================
# Multi-tenancy (wiki/MultiTenancy/Overview.md)
# ==============================================
# false = single tenant (everything belongs to the Default tenant). Can be switched on later without a migration.
MULTITENANCY_ENABLED=false
# Shared (tenant_id + filters + RLS) or Dedicated (own database per tenant) for new tenants
MULTITENANCY_DEFAULT_ISOLATION=Shared
# Subdomain resolution: acme.api.example.com -> tenant "acme" (needs a wildcard DNS record + certificate)
MULTITENANCY_ROOT_DOMAIN=api.example.com
# Postgres Row-Level Security (only effective when the app connects as a NON-superuser role)
MULTITENANCY_RLS_ENABLED=true
# Tenant frontends allowed by CORS: acme.app.example.com (+ verified custom domains). Empty = only Cors__AllowedOrigins
MULTITENANCY_FRONTEND_ROOT_DOMAIN=app.example.com
# Support impersonation of tenant members (permission tenants.impersonate, audited, <= 30 min tokens)
MULTITENANCY_IMPERSONATION_ENABLED=true
# Requests per minute per tenant across all its users (0 = off)
RATE_LIMIT_TENANT_PERMITS=0

# ==============================================
# Hangfire Dashboard Authentication
# ==============================================
# Required for production access to /hangfire
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=

# ==============================================
# JWT Settings
# ==============================================
# Production: Secret in secrets/jwt_secret.txt
# Development: Set secret here (for docker-compose.override.yml)
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
JWT_ISSUER=StarterKitAPI
JWT_AUDIENCE=StarterKitClient
# Production: 15 minutes
# Development: 60 minutes (set in override)
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# ==============================================
# OpenTelemetry Configuration
# ==============================================
OTEL_SERVICE_NAME=starterkit-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ==============================================
# Observability Stack (Optional)
# ==============================================

# Prometheus
PROMETHEUS_RETENTION=30d

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=http://localhost:3000

# ==============================================
# Health Checks
# ==============================================
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=60s

# ==============================================
# Development Tools (Override Only)
# ==============================================
# These are only used when docker-compose.override.yml is active

# Redis Commander
REDIS_COMMANDER_PORT=8081

# Mailhog (Email Testing)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ==============================================
# Production Deployment Notes
# ==============================================
# 
# 1. All ports bind to 127.0.0.1 in production
# 2. Use VPS nginx to proxy to API on localhost:5000
# 3. Secrets are loaded from ./secrets/ directory
# 4. Deploy with: docker compose -f docker-compose.yml up -d
# 5. With observability: docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
#
# ==============================================
# Development Deployment Notes
# ==============================================
#
# 1. docker-compose.override.yml is auto-merged
# 2. All ports are exposed (not localhost-only)
# 3. Secrets are disabled, use env vars directly
# 4. Dev tools included (pgadmin, redis-commander, mailhog)
# 5. Deploy with: docker compose up -d
# 6. With observability: docker compose -f docker-compose.yml -f docker-compose.observability.yml -f docker-compose.override.yml up -d
#
# ==============================================
