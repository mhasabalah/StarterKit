<Project>
  <!--
    Version policy (see wiki/Reference/Template-Backlog.md):
    - Latest STABLE for everything, on .NET 10 LTS.
    - Pinned to the last OSS (free) major on purpose — newer majors are commercially licensed:
        MassTransit 8.x (9+ commercial), FluentAssertions 7.x (8+ commercial). MediatR was removed (owned mediator port,
        wiki/Decisions/0007-owned-mediator-port.md). Licenses of everything: wiki/Reference/Third-Party-Licenses.md.
    - Roslyn (Microsoft.CodeAnalysis.*) pinned to 5.0.0 = the exact version EF Core 10 Design (Workspaces.MSBuild 5.0.0) requires.
    - OpenTelemetry Process/GrpcNetClient/Prometheus have no stable release yet → latest pre-release.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin transitive dependencies to the versions below too (e.g. HealthChecks.UI 9 drags in EF Design 8.0.11). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Core Framework Packages">
    <PackageVersion Include="Asp.Versioning.Abstractions" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Aspire.Seq" Version="13.6.5" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Publisher.Seq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Figgle" Version="0.6.6" />
    <PackageVersion Include="Figgle.Fonts" Version="0.6.6" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup Label="Web API and Carter">
    <PackageVersion Include="Carter" Version="10.0.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>
  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.43" />
  </ItemGroup>
  <ItemGroup Label="Data Access and Entity Framework">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Label="Caching and Redis">
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
    <!-- SignalR scale-out backplane (Notification real-time hub); reuses the app's IConnectionMultiplexer. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
    <!-- FCM HTTP v1 (Android, iOS via APNs, Web push). Apache-2.0. Isolated to the Notification module (ThirdPartyIsolationTests). -->
    <PackageVersion Include="FirebaseAdmin" Version="3.7.0" />
  </ItemGroup>
  <ItemGroup Label="Mapping and Utilities">
    <PackageVersion Include="Mapster" Version="10.0.14" />
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <PackageVersion Include="Stripe.net" Version="53.1.0" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.20.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.20.1-rc.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <PackageVersion Include="Grafana.OpenTelemetry" Version="1.14.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Zipkin" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="Resilience">
    <PackageVersion Include="Polly" Version="8.9.1" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="MassTransit" Version="8.5.12" />
    <PackageVersion Include="MassTransit.Abstractions" Version="8.5.12" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.12" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.12" />
    <PackageVersion Include="MassTransit.SqlTransport.PostgreSql" Version="8.5.12" />
  </ItemGroup>
  <ItemGroup Label="Identity and Security">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!-- Enterprise SSO (Identity only): OIDC discovery/JWKS (same IdentityModel family as above) + SAML 2.0 SP (BSD-3-Clause). -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="ITfoxtec.Identity.Saml2" Version="4.21.0" />
  </ItemGroup>
  <ItemGroup Label="Storage and Image Processing">
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.11" />
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.19" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.10" />
    <!-- Image processing (Attachment thumbnails / validation): MIT, no license key. -->
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.155.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Tabular files (DataTransfer bulk import/export)">
    <!-- Streaming CSV / XLSX readers (MIT). Kept inside the DataTransfer module by ThirdPartyIsolationTests. -->
    <PackageVersion Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageVersion Include="Sylvan.Data.Excel" Version="0.5.8" />
  </ItemGroup>
  <ItemGroup Label="Key management (Data Protection key encryption, KMS)">
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="AWSSDK.KeyManagementService" Version="4.0.101.4" />
  </ItemGroup>
  <ItemGroup Label="Background Jobs">
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
  </ItemGroup>
  <ItemGroup Label="Email">
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Fluid.Core" Version="2.41.1" />
  </ItemGroup>
  <ItemGroup Label="Security pins (transitive)">
    <!-- Pulled in by Aspire hosting; 15.0.1 has GHSA-w7r3-mgwf-4mqq. Remove once Aspire ships a fixed dependency. -->
    <PackageVersion Include="KubernetesClient" Version="21.0.8" />
    <!-- Pulled in by Grafana.OpenTelemetry -> OpenTelemetry.Instrumentation.Wcf -> System.ServiceModel (8.0.x): GHSA-w3x6-4m5h-cxqf and others (Xml), GHSA-846f-f764-76mx (Pkcs). Remove once the Wcf instrumentation ships a fixed dependency. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Aspire Hosting">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Seq" Version="13.6.5" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- xUnit v3 without Microsoft.Testing.Platform: keeps VSTest dotnet test, the filter option and coverlet (CI). -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
  </ItemGroup>
</Project>
