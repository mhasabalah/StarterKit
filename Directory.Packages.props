  <ItemGroup Label="Resilience">
    <PackageVersion Include="Polly" Version="8.6.5" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="MassTransit" Version="8.5.7" />
  </ItemGroup>
  <ItemGroup Label="Identity and Security">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.9" />
