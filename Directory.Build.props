<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Analyzer policy (wiki/Architecture/CodingStandards.md (Analyzers)): recommended rule set, warnings are errors.
		     Relax a rule in .editorconfig with a justification, never with a blanket NoWarn. -->
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- CS1591: Missing XML comment for publicly visible type or member -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<!-- AV0029/AV0030 (Asp.Versioning OpenAPI wiring): the host serves one fixed "v1" document via AddOpenApi("v1"); moving to
		     Asp.Versioning.OpenApi (a document per version) is a separate, behaviour-changing change. A project-level NoWarn is
		     needed because the diagnostic is also raised inside the OpenAPI XML-comment source generator's output, which
		     .editorconfig severities do not reach. -->
		<NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
		<!-- Default (non-.ar) resx files are English; also satisfies CA1824. -->
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>
	<!--#if (templateSource)-->

	<!-- Template repository only (wiki/Getting-Started/Templates.md): compile every optional part, so the template itself
	     builds and tests exactly what `dotnet new starterkit` generates with all switches on. Code behind
	     `#if (SAMPLE)` is kept or removed by the template engine; this block is never copied into a generated project. -->
	<PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory).template.config/template.json')">
		<DefineConstants>$(DefineConstants);SAMPLE</DefineConstants>
	</PropertyGroup>
	<!--#endif-->
</Project>
