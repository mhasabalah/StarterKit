{
  "name": "starterkit-docs-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run sync && next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:markdown": "node scripts/check-markdown.mjs",
    "check:spelling": "cspell --no-progress --no-summary content/docs/**/*.md content/home.mdx",
    "check:vale": "vale content/docs content/home.mdx",
    "check:links": "node scripts/check-links.mjs",
    "check:external": "lychee --config lychee.toml --no-progress .generated/external-links.txt",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "export:openapi": "node scripts/export-openapi.mjs",
    "check": "npm run sync && npm run test && npm run typecheck && npm run lint && npm run check:markdown && npm run check:spelling"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.2.8",
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.1",
    "fumadocs-openapi": "12.6.2",
    "fumadocs-ui": "16.19.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "1.72.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.3.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shiki": "4.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "cspell": "10.5.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "markdownlint-cli2": "0.24.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
