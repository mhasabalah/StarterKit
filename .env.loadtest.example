# ==============================================
# StarterKit load-test stack (docker-compose.loadtest.yml) - copy to .env.loadtest (git-ignored) and replace every
# CHANGE_ME with a random value, or run `make loadtest-env` which generates them. wiki/Testing/Load-Testing.md
# ==============================================
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
OTP_HMAC_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Password of the seeded SuperAdmin (Identity:SeedAdmin:Password); seed.js logs in with it. Needs upper/lower/digit/symbol.
LOAD_ADMIN_PASSWORD=CHANGE_ME
# Password given to every load user seed.js registers. Same complexity rules.
LOAD_USER_PASSWORD=CHANGE_ME
# Hangfire dashboard (/hangfire, user "admin") stays authenticated; the port is bound to 127.0.0.1 only.
HANGFIRE_DASHBOARD_PASSWORD=CHANGE_ME

# Optional
LOADTEST_API_PORT=5090
LOAD_DURATION=30s
LOAD_RATE_SCALE=1
LOAD_IMPORT_ROWS=200
LOAD_USERS=20
LOAD_PRODUCTS=40
API_CPUS=2.0
API_MEMORY_LIMIT=2g
