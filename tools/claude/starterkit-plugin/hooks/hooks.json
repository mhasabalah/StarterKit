{
  "description": "StarterKit guardrails: block agent commits/pushes (the user reviews and commits) and warn on forbidden C# patterns right after an edit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-git.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-csharp-guardrails.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
